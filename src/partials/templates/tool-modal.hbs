<button class="tool-modal__close" type="button">
  ✕
</button>
<div class="tool-modal__logo">
  <img class="tool-modal__img" src="{{logo}}" alt="{{name}}" />
</div>
<h2 class="tool-modal__name">{{name}}</h2>
<p class="tool-modal__desc">{{description}}</p>
<span class="tool-modal__price">{{pricing}}</span>
<a
  class="tool-modal__link"
  href="{{url}}"
  target="_blank"
  rel="noopener noreferrer"
>
  Перейти до сервісу
  <svg class="tool-modal__icon">
    <use href="#icon-arrow"></use>
  </svg>
</a>